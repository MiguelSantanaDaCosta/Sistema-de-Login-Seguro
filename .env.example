# Copie para .env (que está no .gitignore) e preencha. NUNCA commite o .env.

# --- Banco ---
# Atlas (produção/entrega): inclua /thindesk antes do "?" e URL-encode a senha
MONGO_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/thindesk?retryWrites=true&w=majority&appName=Thindesk
# Local com Docker (alternativa):
# MONGO_URI=mongodb://localhost:27017/thindesk

# --- JWT --- (gere com: openssl rand -base64 64)
JWT_SECRET=troque-por-uma-string-aleatoria-de-64-bytes

# --- Servidor ---
SERVER_PORT=8000
# Usado nos links enviados por email
APP_BASE_URL=http://localhost:8000

# --- Admin ---
# Email do admin criado no primeiro start (recebe os links de confirmação do login)
ADMIN_EMAIL=admin@thindesk.local

# --- Email ---
# false: os links aparecem no console do servidor (bom para desenvolver)
MAIL_ENABLED=false
# Para enviar de verdade (ex.: Mailtrap https://mailtrap.io):
# MAIL_ENABLED=true
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=
# MAIL_PASSWORD=

# --- Puzzle (opcionais; valores padrão abaixo) ---
# PUZZLE_RATING_MAX=1100
# PUZZLE_TEMPO_LIMITE=300
# PUZZLE_MAX_POR_SESSAO=3

# --- SOMENTE TESTES (./test.sh): devolve o link do email no JSON. NUNCA em produção. ---
# DEV_EXPOR_LINK=true
