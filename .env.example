# Copie para .env (que está no .gitignore) e preencha. NUNCA commite o .env.

# --- Banco ---
# O Thindesk usa MongoDB Atlas (plano gratuito M0).
# Formato da URI:
#   mongodb+srv://USUARIO:SENHA@cluster.xxxxx.mongodb.net/thindesk?appName=AppName
#
# Dois pontos que quebram a conexão:
#   1. O Atlas entrega a URI SEM o nome do banco. Insira /thindesk antes do "?".
#   2. Se a senha tiver caracteres especiais (@ : / ? # & %), faça URL-encode.
#      Ex.: "p@ss" -> "p%40ss".
#
# Passo a passo completo (cluster, Network Access, verificação de índices):
# veja a seção "MongoDB Atlas" no README.md.
MONGO_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/thindesk?appName=Thindesk

# Alternativa local (desenvolvimento):
# MONGO_URI=mongodb://localhost:27017/thindesk
# --- JWT --- (gere com: openssl rand -base64 64)
JWT_SECRET=troque-por-uma-string-aleatoria-de-64-bytes

# --- Servidor ---
SERVER_PORT=8000
# Usado nos links enviados por email
APP_BASE_URL=http://localhost:8000
# Deploy com HTTPS (Caddy + Let's Encrypt): domínio e URL pública (usada nos links dos emails)
# DOMINIO=thindesk-santana.duckdns.org
# APP_BASE_URL=https://thindesk-santana.duckdns.org

# --- Admin ---
# Email do admin criado no primeiro start (recebe os links de confirmação do login)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@thindesk.local
# Email que SEMPRE recebe puzzles fáceis (<= 1000), qualquer perfil. Se vazio, usa o ADMIN_EMAIL.
# Fica no ambiente de propósito: nenhum email pessoal no código.
# PUZZLE_EMAIL_FACIL=seu.email@exemplo.com

# --- Email ---
# false: os links aparecem no console do servidor (bom para desenvolver)
MAIL_ENABLED=false

# Para enviar de verdade com Gmail:
#  1) Ative a verificação em 2 etapas na conta Google
#  2) Gere uma "Senha de app" em https://myaccount.google.com/apppasswords
#  3) Preencha abaixo (MAIL_PASSWORD = os 16 caracteres, sem espaços)
# MAIL_ENABLED=true
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=seu.email@gmail.com
# MAIL_PASSWORD=abcdefghijklmnop

# --- Puzzle: faixa de rating por perfil (opcionais; valores padrão abaixo) ---
# PUZZLE_USUARIO_MIN=1100
# PUZZLE_USUARIO_MAX=1399
# USUARIO usa 0..PUZZLE_RATING_MAX; TECNICO e ADMIN têm faixas mais difíceis
# PUZZLE_TECNICO_MIN=1400
# PUZZLE_TECNICO_MAX=1800
# PUZZLE_ADMIN_MIN=1900
# PUZZLE_ADMIN_MAX=2400

# --- Root (rainha vermelha) ---
# CUIDADO: dá acesso TOTAL ao banco, SEM login, a quem vencer o desafio (N puzzles seguidos).
# Desligado por padrão. Ligue só se aceitar esse risco.
# ROOT_ENABLED=true
# ROOT_PUZZLES=5
# ROOT_TEMPO_SEGUNDOS=300
# ROOT_RATING_MIN=3000        # rating mínimo dos puzzles do desafio
# ROOT_MIN_SEGUNDOS=4         # resposta mais rápida que isso = bot (bloqueio do IP)

# --- Proteção anti-bot (desafio root): bloqueia o IP por 1h e responde 418 "Eu sou um bule de chá" ---
# BOT_PROTECAO=true
# BOT_BLOQUEIO_MINUTOS=60
# BOT_IPS_PERMITIDOS=203.0.113.10   # IPs que nunca são bloqueados (ex.: o seu)

# --- Admin inicial (usado só na 1ª subida, quando o admin ainda não existe) ---
ADMIN_PASSWORD=troque-esta-senha

# --- Puzzle (opcionais; valores padrão abaixo) ---
# PUZZLE_TEMPO_LIMITE=300
# PUZZLE_MAX_POR_SESSAO=3

# --- SOMENTE TESTES (./test.sh): devolve o link do email no JSON. NUNCA em produção. ---
# DEV_EXPOR_LINK=true


# --- Microserviço de chamados (ms-chamados) ---
# O JWT_SECRET acima DEVE ser idêntico ao do ms-chamados.
CHAMADOS_URL=http://localhost:8081

# --- Contas de demonstração (criadas por um ADMIN em /admin/demos; nada fixo no código) ---
# DEMO_ENABLED=true

# --- Análise puzzles x partidas reais do Lichess (dashboard) ---
# ANALISE_ENABLED=true
# ANALISE_AMOSTRA=1500
# ANALISE_INTERVALO_MS=1100
