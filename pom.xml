<!--
    Projeto baseado no Spring Boot Parent.
    As versões dos starters e plugins mais comuns
    ficam centralizadas aqui para evitar incompatibilidades.
-->

<parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.0</version>
    <relativePath/>
</parent>

<!-- Identificação da aplicação -->

<groupId>com.pfc</groupId> <artifactId>thindesk</artifactId> <version>1.0-alpha</version>

<!-- Aplicação empacotada como JAR executável -->

<packaging>jar</packaging>

<properties>
    <!-- Versão utilizada na compilação -->
    <java.version>21</java.version>

```
<!-- Encoding padrão do projeto -->
<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

<thymeleaf-layout-dialect.version>3.3.0</thymeleaf-layout-dialect.version>
```

</properties>

<dependencies>

```
<!-- APIs REST, MVC e Tomcat embarcado -->
<dependency>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-web</artifactId>
</dependency>

<!-- Renderização de páginas HTML -->
<dependency>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-thymeleaf</artifactId>
</dependency>

<!-- Suporte a layouts e fragmentos reutilizáveis -->
<dependency>
    <groupId>nz.net.ultraq.thymeleaf</groupId>
    <artifactId>thymeleaf-layout-dialect</artifactId>
    <version>${thymeleaf-layout-dialect.version}</version>
</dependency>

<!-- Integração Thymeleaf + Spring Security -->
<dependency>
    <groupId>org.thymeleaf.extras</groupId>
    <artifactId>thymeleaf-extras-springsecurity6</artifactId>
</dependency>

<!-- Persistência com MongoDB -->
<dependency>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-data-mongodb</artifactId>
</dependency>

<!-- Autenticação e autorização -->
<dependency>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-security</artifactId>
</dependency>

<!-- Envio de e-mails -->
<dependency>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-mail</artifactId>
</dependency>

<!-- Validação de DTOs e formulários -->
<dependency>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-validation</artifactId>
</dependency>

<!-- Redução de código repetitivo -->
<dependency>
    <groupId>org.projectlombok</groupId>
    <artifactId>lombok</artifactId>
    <optional>true</optional>
</dependency>

<!-- Dependências de testes -->
<dependency>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-test</artifactId>
    <scope>test</scope>
</dependency>

<!-- Recursos auxiliares para testes de segurança -->
<dependency>
    <groupId>org.springframework.security</groupId>
    <artifactId>spring-security-test</artifactId>
    <scope>test</scope>
</dependency>
```

</dependencies>

<build>
    <plugins>

```
    <!-- Geração do JAR executável da aplicação -->
    <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>

        <configuration>
            <mainClass>com.pfc.ThindeskApplication</mainClass>

            <!-- Lombok não precisa ser distribuído junto da aplicação -->
            <excludes>
                <exclude>
                    <groupId>org.projectlombok</groupId>
                    <artifactId>lombok</artifactId>
                </exclude>
            </excludes>
        </configuration>

    </plugin>

</plugins>
```

</build>

